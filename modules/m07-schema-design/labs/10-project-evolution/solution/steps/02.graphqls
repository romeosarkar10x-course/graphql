# Step 2, after change request 2: memberships with role and joinedAt.
type Query {
  club(id: ID!): Club
  clubs: [Club!]!
  book(id: ID!): Book
}

type Club {
  id: ID!
  name: String!
  "Plain text."
  description: String @deprecated(reason: "Use about (Markdown). Release-0 apps still read this.")
  "The club's description in Markdown."
  about: String
  owner: User!
  currentBook: Book
  members: [User!]!
  "Members with their role in this club, in join order."
  memberships: [Membership!]!
}

"One member's place in one club."
type Membership {
  user: User!
  role: ClubRole!
  "ISO-8601 instant."
  joinedAt: String!
}

"What a member may do in a club."
enum ClubRole {
  OWNER
  MODERATOR
  MEMBER
}

type User {
  id: ID!
  name: String!
  handle: String!
}

type Book {
  id: ID!
  title: String!
  "The author, as printed. One name."
  author: String!
  reviews: [Review!]!
}

type Review {
  id: ID!
  "1 to 5 stars."
  rating: Int!
  body: String
  author: User!
}
