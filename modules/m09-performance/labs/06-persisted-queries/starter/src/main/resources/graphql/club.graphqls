# Module 9's club dashboard. Every lab serves this schema; only the data loading changes.
# Data: bin/course clubs <schema> (contract/ClubData.java). Ids are the database ids.
type Query {
  club(id: ID!): Club
  "Clubs in id order."
  clubs(first: Int = 10): [Club!]!
  "The reader in the X-Shelfie-User header, or null."
  viewer: Reader
}

type Mutation {
  "Rename a book (Module 9.5: every cache must notice)."
  renameBook(id: ID!, title: String!): Book
  "Add a review as the viewer (X-Shelfie-User header)."
  addReview(bookId: ID!, rating: Int!, body: String!): Review
}

type Club {
  id: ID!
  name: String!
  owner: Reader!
  "Null for every tenth club."
  currentBook: Book
  memberCount: Int!
  "The books the owner reviewed most recently, newest first."
  ownerPicks(first: Int = 3): [Book!]!
  "Members in join order."
  members(first: Int = 20): [Reader!]!
}

type Reader {
  id: ID!
  handle: String!
  name: String!
  "Newest first."
  reviews(first: Int = 5): [Review!]!
}

type Review {
  id: ID!
  rating: Int!
  body: String!
  book: Book!
  author: Reader!
}

type Book {
  id: ID!
  title: String!
  author: String!
}
