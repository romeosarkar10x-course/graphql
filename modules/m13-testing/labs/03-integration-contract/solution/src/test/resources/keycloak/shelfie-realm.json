{
  "realm": "shelfie",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "member"
      },
      {
        "name": "moderator"
      },
      {
        "name": "admin"
      }
    ]
  },
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "course-rsa",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "shelfie-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "jsonType.label": "String"
          }
        },
        {
          "name": "aud",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "shelfie-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ada",
      "enabled": true,
      "email": "ada@shelfie.test",
      "emailVerified": true,
      "firstName": "ada",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "ada-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "member"
      ]
    },
    {
      "username": "ben",
      "enabled": true,
      "email": "ben@shelfie.test",
      "emailVerified": true,
      "firstName": "ben",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "ben-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "member"
      ]
    },
    {
      "username": "max",
      "enabled": true,
      "email": "max@shelfie.test",
      "emailVerified": true,
      "firstName": "max",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "max-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "member",
        "moderator"
      ]
    },
    {
      "username": "olu",
      "enabled": true,
      "email": "olu@shelfie.test",
