extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.9",
        import: ["@key", "@external", "@provides", "@interfaceObject"])

type Query {
  "Newest first."
  latestReviews(first: Int = 5): [Review!]!
}

type Review @key(fields: "id") {
  id: ID!
  rating: Int!
  body: String!
  "Reviews stores each author's handle with the review, so it can answer that much itself."
  author: User! @provides(fields: "handle")
  media: Media!
}

type User @key(fields: "id") {
  id: ID!
  handle: String! @external
  reviews: [Review!]!
}

"Reviews works on any Media without knowing its implementations: catalog's interface, seen as one type."
type Media @key(fields: "id") @interfaceObject {
  id: ID!
  reviews: [Review!]!
  reviewCount: Int!
  "Null without reviews."
  averageRating: Float
}
