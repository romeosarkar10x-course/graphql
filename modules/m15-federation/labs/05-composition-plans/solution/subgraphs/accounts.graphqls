extend schema @link(url: "https://specs.apollo.dev/federation/v2.9", import: ["@key", "@shareable"])

type Query {
  "The signed-in reader: the user named by the X-Shelfie-User header, null without one."
  me: User
  user(id: ID!): User
  users: [User!]!
}

"A Shelfie reader. Owned by the accounts team."
type User @key(fields: "id") {
  id: ID!
  name: String!
  handle: String! @shareable
  city: String
}
