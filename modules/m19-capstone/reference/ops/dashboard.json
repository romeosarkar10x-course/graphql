{
  "uid": "toolshed",
  "title": "Toolshed",
  "tags": [
    "toolshed",
    "capstone"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second by subgraph and outcome",
      "description": "Spring for GraphQL's graphql.request timer, per subgraph. The router's own traffic is in its traces.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, graphql_outcome) (rate(graphql_request_seconds_count[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 request time by subgraph",
      "description": "From the histogram buckets (percentiles-histogram in application.yaml). Runbook: 'Slow catalogue'.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(graphql_request_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "SQL statements per GraphQL request",
      "description": "The N+1 alarm: flat at 3 to 5. A rise after a deploy means a resolver lost its batch. Runbook: 'Statements per request'.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(toolshed_db_statements_total[$__rate_interval])) / sum by (application) (rate(graphql_request_seconds_count[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Field errors by field",
      "description": "Resolvers that threw: FORBIDDEN and UNAUTHORIZED are expected in small numbers; anything else is a bug.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, graphql_field_name) (rate(graphql_datafetcher_seconds_count{graphql_outcome=\"ERROR\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Borrow results",
      "description": "Borrowed against the typed failures. A jump in ToolUnavailable is demand, in InvalidInput a client bug.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(toolshed_borrow_results_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Heap used by subgraph",
      "description": "Each subgraph runs with -Xmx256m in the course.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}