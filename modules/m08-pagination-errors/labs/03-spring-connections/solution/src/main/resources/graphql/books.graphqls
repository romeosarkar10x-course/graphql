type Query {
  """
  Books in (published, id) order. `first` defaults to 20; `first` or `last` above 100, or below 0,
  is a BAD_REQUEST error. BookConnection, BookEdge and PageInfo are generated by Spring for GraphQL.
  """
  books(first: Int, after: String, last: Int, before: String): BookConnection!
}

type Book {
  id: ID!
  title: String!
  author: String!
  published: Int!
}
