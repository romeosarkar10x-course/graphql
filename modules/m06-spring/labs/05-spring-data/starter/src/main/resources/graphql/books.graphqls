"Lab 6.5: Shelfie's catalogue from a database (JPA + H2)."
type Query {
  "Generated by @GraphQlRepository: findById."
  book(id: ID!): Book
  "Generated by @GraphQlRepository: Query by Example; every argument is an exact match on that property."
  books(author: String, publishedYear: Int): [Book!]!
  "Hand-written: case-insensitive title search, sorted by year."
  searchBooks(titleContains: String!): [Book!]!
}

type Book {
  id: ID!
  title: String!
  author: String!
  isbn: String
  publishedYear: Int
}
