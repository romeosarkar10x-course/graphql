# One file, everything in it. Split it into at least five files by area (README), and grow it.
type Query {
  club(id: ID!): Club
  clubs: [Club!]!
  book(id: ID!): Book
  user(id: ID!): User
}

type Club {
  id: ID!
  name: String!
  description: String
  owner: User!
  members(first: Int = 10): [User!]!
  memberCount: Int!
  "Old name for memberCount."
  size: Int!
  currentBook: Book
  visibility: Visibility!
  createdAt: String!
}

enum Visibility {
  PUBLIC
  PRIVATE
}

type User {
  id: ID!
  name: String!
  handle: String!
  clubs: [Club!]!
  reviews: [Review!]!
}

type Book {
  id: ID!
  title: String!
  authors: [String!]!
  isbn: String!
  averageRating: Float
  reviews(last: Int = 5): [Review!]!
}

type Review {
  id: ID!
  rating: Int!
  body: String!
  author: User!
  book: Book!
  createdAt: String!
}
