extend schema @link(url: "https://specs.apollo.dev/federation/v2.9", import: ["@key", "@external", "@provides"])

type Query {
  review(id: ID!): Review
  "Newest first."
  latestReviews(first: Int = 5): [Review!]!
}

type Review @key(fields: "id") {
  id: ID!
  rating: Int!
  body: String!
  "Reviews keeps a copy of each author's handle, so it can answer that without accounts."
  author: User! @provides(fields: "handle")
  book: Book!
}

type Book @key(fields: "id") {
  id: ID!
  "Oldest first. reviews, reviewCount and averageRating share one store query per level, however many are asked for."
  reviews: [Review!]!
  reviewCount: Int!
  "Null without reviews."
  averageRating: Float
}

type User @key(fields: "id") {
  id: ID!
  handle: String! @external
  reviews: [Review!]!
}
