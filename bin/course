#!/usr/bin/env bash
# Course runner. Builds, tests and servers all run inside the course Docker image, never on the host.
#
#   bin/course doctor                     check host + image + services; tells you what to fix
#   bin/course ref up [--rebuild]|down|status|logs|reset   reference Shelfie (+ Toxiproxy, storage); reset = seed data
#   bin/course toxi latency <ms> | reset  add/remove latency on the slow Shelfie URL (:8666)
#   bin/course list [mNN]                 modules and labs
#   bin/course start mNN/NN [--force]     copy a lab's starter into workspace/
#   bin/course test  mNN/NN [--solution|--starter]   grade your copy (or the reference solution)
#   bin/course grade mNN/NN               print the rubric prompt for an AI grader (rubric labs)
#   bin/course check [mNN] [--starters]   course self-test: every solution passes (and starters fail)
#   bin/course checkpoint NN              verify a module's checkpoint and git-tag workspace/
#   bin/course hurl <file.hurl> [args]    run Hurl inside the course network ({{ref}}, {{slow}} preset)
#   bin/course jshell [file.jsh]          jshell with Jackson 3 and graphql-java on the class path
#   bin/course java <File.java> [args]    run a single-file Java program with the same class path
#   COURSE_PUBLISH=4000 bin/course shell  publish that port on the host, so friends can reach your server (group games)
#   COURSE_DOCKER=1 bin/course shell      mount the host's Docker socket (Testcontainers, Module 13.3; test/check do it
#                                         by themselves for labs whose lab.json needs "docker")
#   bin/course gql validate|operations|schema-lines|coordinates|stats ...   document and schema helpers (tools/gql/Gql.java)
#   bin/course design lint|shape|clients|diff|outage ...   schema-design helpers, Module 7 (tools/design/Design.java)
#   bin/course catalog <schema> [rows]    Module 8: load the deterministic book catalogue into PostgreSQL
#   bin/course clubs <schema> [scale]     Module 9: load the deterministic club dataset into PostgreSQL
#   bin/course token <user> [--expired|--forged|--none|--aud a|--claim k=v]   Module 10: mint a JWT signed with the course key
#   bin/course shell [-c 'cmd']           bash inside the course image, repo at /course
#   bin/course native <mvn args>          mvn inside a GraalVM CE 25 image, for native builds (game 6b)
#   bin/course inspector <args>           graphql-inspector 7.0.2 (Node.js, own image), e.g. diff old.graphql new.graphql
#   bin/course node <cmd>                 Node.js 24 (copied from the official image) inside the course image, e.g.
#                                         bin/course node npm ci, bin/course node npx eslint (Module 13.6-13.7)
#   bin/course fed                        Module 15: fetch Apollo Router 2.19.0, Hive Router 0.3.9 and Rover 1.0.1 into .cache/fed/bin
#                                         (labs that need "fed" do it by themselves)
#   bin/course ops                        Module 16: fetch Prometheus 3.16.0, Tempo 3.1.1 and Grafana 13.3.0 into .cache/ops
#                                         (about 670 MB; labs that need "ops" do it by themselves)
#   bin/course web <npm args>             Module 12's web lab: npm in a Node.js 24 image on the course network
#   bin/course mobile <cmd>               Module 12's mobile lab: Gradle 9.9 + JDK 21 image on the course network
#   bin/course go <args>                  Module 18's Go port: Go 1.27.2 image, static builds, caches in .cache/go
#   bin/course rover <args>               Module 15: Apollo's Rover CLI (accepts its Elastic License 2.0)
#   bin/course seckit <tool> <args>       Module 10 scanners (graphql-cop, clairvoyance), own image; shares the
#                                         network of your running course container, so target localhost:4000
#   bin/course image                      (re)build the course image
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${GQL_COURSE_IMAGE:-graphql-course:1}"
NETWORK=gqlcourse
export COURSE_UID="$(id -u)" COURSE_GID="$(id -g)"

die() { echo "course: $*" >&2; exit 1; }
build_image() { docker build -t "$IMAGE" "$ROOT/docker"; }

compose() { docker compose -f "$ROOT/docker/compose.yaml" "$@"; }

# What a lab needs beyond the image comes from lab.json's "needs": wants_need <need> <command> <args...> says whether
# any lab in the command's scope needs it.
wants_need() {
  local need="$1" cmd="$2" pat=""; shift 2
  case "$cmd" in
    test) [[ "${1:-}" =~ ^m([0-9]{2})/([0-9]{2})$ ]] && pat="modules/m${BASH_REMATCH[1]}-*/labs/${BASH_REMATCH[2]}-*/lab.json" ;;
    check) pat="modules/m*/labs/*/lab.json"
           for a in "$@"; do [[ "$a" =~ ^m[0-9]{2}$ ]] && pat="modules/${a}-*/labs/*/lab.json"; done ;;
    checkpoint) [[ "${1:-}" =~ ^[0-9]{2}$ ]] && pat="modules/m${1}-*/labs/*/lab.json" ;;
  esac
  [[ -n "$pat" ]] && (cd "$ROOT" && grep -lsE "\"needs\":[^]]*\"$need\"" $pat >/dev/null)
}
# "docker" (Testcontainers, Module 13.3): those labs get the host's Docker socket, and only those, because the
# socket gives the container control of the host's Docker. COURSE_DOCKER=1 bin/course shell mounts it by hand.
docker_sock=()
sock=/var/run/docker.sock
if [[ -S "$sock" ]] && { wants_need docker "${1:-}" "${@:2}" || [[ "${1:-}" == shell && "${COURSE_DOCKER:-}" == 1 ]]; }; then
  docker_sock=(-v "$sock:$sock" --group-add "$(stat -L -c %g "$sock" 2>/dev/null || stat -L -f %g "$sock" 2>/dev/null || echo 0)")
fi
# "node" (graphql-eslint, SpectaQL, Module 13.6-13.7): Node.js copied once from the official image into .cache/node,
# so the course image stays Java-only and tests can still run npm tools. bin/course node <args> runs it by hand.
NODE_IMAGE=node:24.22.1-slim
ensure_node() {
  [[ -x "$ROOT/.cache/node/bin/node" ]] && return 0
  echo "course: copying Node.js from $NODE_IMAGE into .cache/node (once, about 140 MB)" >&2
  docker image inspect "$NODE_IMAGE" >/dev/null 2>&1 || docker pull -q "$NODE_IMAGE" >&2
  local c; c=$(docker create "$NODE_IMAGE")
  mkdir -p "$ROOT/.cache/node/bin" "$ROOT/.cache/node/lib"
  docker cp -q "$c:/usr/local/bin/node" "$ROOT/.cache/node/bin/node" && docker cp -q "$c:/usr/local/lib/node_modules" "$ROOT/.cache/node/lib/"
  docker container rm "$c" >/dev/null
  printf '#!/bin/sh\nexec "$(dirname "$0")/node" "$(dirname "$0")/../lib/node_modules/npm/bin/npm-cli.js" "$@"\n' > "$ROOT/.cache/node/bin/npm"
  printf '#!/bin/sh\nexec "$(dirname "$0")/node" "$(dirname "$0")/../lib/node_modules/npm/bin/npx-cli.js" "$@"\n' > "$ROOT/.cache/node/bin/npx"
  chmod +x "$ROOT/.cache/node/bin/npm" "$ROOT/.cache/node/bin/npx"
}
if wants_need node "${1:-}" "${@:2}" || [[ "${1:-}" == node ]]; then ensure_node; fi

# "fed" (Module 15): two federation routers and Apollo's Rover CLI, downloaded once from their official GitHub releases into .cache/fed/bin
# and checked against these SHA-256 sums, plus Node.js for the composer (contract/compose). Linux x86_64 builds: the
# routers run inside the course image. bin/course fed fetches them by hand.
FED_FILES=(
  "router|https://github.com/apollographql/router/releases/download/v2.19.0/router-v2.19.0-x86_64-unknown-linux-gnu.tar.gz|b606982f3cfe986e01bbde12d8cf5cd0fd783df2fc754998d3bdf0e5d2b9b308"
  "hive-router|https://github.com/graphql-hive/router/releases/download/hive-router/v0.3.9/hive_router_linux_amd64|f18ea5e8e0398b3bb34e56a16b056219f2a56f289e4be06d7f745e4faa1c852d"
  "rover|https://github.com/apollographql/rover/releases/download/v1.0.1/rover-v1.0.1-x86_64-unknown-linux-gnu.tar.gz|9ef34ab03683a2bcf680e7e890ffeca2ddaf9b7f9059589ad1bcfbf684a912db"
)
ensure_fed() {
  local entry name url sum dir="$ROOT/.cache/fed" tmp
  mkdir -p "$dir/bin" "$dir/dl"
  for entry in "${FED_FILES[@]}"; do
    IFS='|' read -r name url sum <<<"$entry"
    [[ -x "$dir/bin/$name" ]] && continue
    tmp="$dir/dl/$(basename "$url")"
    echo "course: downloading $name ($(basename "$url")) into .cache/fed (once)" >&2
    [[ -f "$tmp" ]] || curl -fsSL -o "$tmp" "$url" || die "download failed: $url"
    echo "$sum  $tmp" | sha256sum -c --quiet - || { rm -f "$tmp"; die "checksum mismatch for $tmp"; }
    case "$tmp" in
      *.tar.gz) tar -xzf "$tmp" -C "$dir/dl" && mv "$dir/dl/dist/$name" "$dir/bin/$name" ;;
      *) cp "$tmp" "$dir/bin/$name" ;;
    esac
    chmod +x "$dir/bin/$name"
  done
}
if wants_need fed "${1:-}" "${@:2}" || [[ "${1:-}" == fed || "${1:-}" == rover ]]; then ensure_node; ensure_fed; fi

# "ops" (Module 16): Prometheus, Tempo and Grafana from their official releases into .cache/ops (binaries in
# .cache/ops/bin, Grafana's home in .cache/ops/grafana), checked against these SHA-256 sums. Linux x86_64 builds: they
# run inside the course image, started and stopped by the tests (modules/m16-production/contract/ops.sh).
OPS_FILES=(
  "prometheus|https://github.com/prometheus/prometheus/releases/download/v3.16.0/prometheus-3.16.0.linux-amd64.tar.gz|68727009472a2c02e1ff7f062fd5b3e637285bffc8fc2d340c76fb449d6e0f34"
  "tempo|https://github.com/grafana/tempo/releases/download/v3.1.1/tempo_3.1.1_linux_amd64.tar.gz|cc7efc370d2e5cfdf93792060da4ea9d6c2a3aae348ccc95cbaaaf3393e1d339"
  "grafana|https://dl.grafana.com/oss/release/grafana-13.3.0.linux-amd64.tar.gz|cec8f98cc59bc1a1945833b652371a073be678c5c159a9b1695ad63c04fae5a7"
)
ensure_ops() {
  local entry name url sum dir="$ROOT/.cache/ops" tmp
  mkdir -p "$dir/bin" "$dir/dl"
  for entry in "${OPS_FILES[@]}"; do
    IFS='|' read -r name url sum <<<"$entry"
    [[ -x "$dir/bin/$name" || -x "$dir/$name/bin/$name" ]] && continue
    tmp="$dir/dl/$(basename "$url")"
    echo "course: downloading $name ($(basename "$url")) into .cache/ops (once)" >&2
    [[ -f "$tmp" ]] || curl -fsSL -o "$tmp" "$url" || die "download failed: $url"
    echo "$sum  $tmp" | sha256sum -c --quiet - || { rm -f "$tmp"; die "checksum mismatch for $tmp"; }
    case "$name" in
      prometheus) tar -xzf "$tmp" -C "$dir/bin" --strip-components=1 prometheus-3.16.0.linux-amd64/prometheus prometheus-3.16.0.linux-amd64/promtool ;;
      tempo) tar -xzf "$tmp" -C "$dir/bin" tempo ;;
      grafana) rm -rf "$dir/grafana" && tar -xzf "$tmp" -C "$dir" && mv "$dir/grafana-13.3.0" "$dir/grafana" ;;
    esac
  done
}
if wants_need ops "${1:-}" "${@:2}" || [[ "${1:-}" == ops ]]; then ensure_ops; fi

# Run a command in the course image, on the course network when it exists.
in_image() {
  local net=() tty=(-i)
  docker network inspect "$NETWORK" >/dev/null 2>&1 && net=(--network "$NETWORK")
  [[ -t 0 && -t 1 ]] && tty=(-it)
  local workdir=/course
  case "$PWD/" in "$ROOT"/*) workdir="/course${PWD#"$ROOT"}" ;; esac
  docker run --rm "${tty[@]}" "${net[@]}" \
    -u "$COURSE_UID:$COURSE_GID" -e HOME=/tmp \
    -e GITHUB_TOKEN="${GITHUB_TOKEN:-}" \
    ${SHELFIE_URL:+-e SHELFIE_URL="$SHELFIE_URL"} \
    ${COURSE_PUBLISH:+-p "$COURSE_PUBLISH:$COURSE_PUBLISH"} \
    "${docker_sock[@]}" \
    -v "$ROOT":/course -w "$workdir" \
    "$IMAGE" "$@"
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  help|-h|--help) awk 'NR > 1 && !/^#/ {exit} NR > 1 {sub(/^# ?/, ""); print}' "$0"; exit 0 ;;
  image) build_image; exit 0 ;;
esac

command -v docker >/dev/null || die "docker not found. See SETUP.md."
docker image inspect "$IMAGE" >/dev/null 2>&1 || { echo "course: building image $IMAGE (first run)..." >&2; build_image >&2; }
mkdir -p "$ROOT/.cache/m2" "$ROOT/workspace"
lib_stamp=$(sha256sum "$ROOT/tools/course-lib/pom.xml" | cut -c1-16)
if [[ "$(cat "$ROOT/.cache/course-lib/.stamp" 2>/dev/null)" != "$lib_stamp" ]]; then
  rm -rf "$ROOT/.cache/course-lib"
  in_image mvn -q -f tools/course-lib/pom.xml package && echo "$lib_stamp" >"$ROOT/.cache/course-lib/.stamp"
fi

case "$cmd" in
  ref)
    sub="${1:-status}"
    case "$sub" in
      up)
        recreate=()
        if [[ ! -f "$ROOT/reference/shelfie-ref/target/shelfie-ref.jar" || "${2:-}" == "--rebuild" ]]; then
          in_image mvn -q -f reference/shelfie-ref/pom.xml -DskipTests package
          recreate=(--force-recreate)   # a running JVM must not keep serving from a replaced jar
        fi
        compose up -d --wait "${recreate[@]}"
        # Toxiproxy route: toxiproxy:8666 -> shelfie-ref:8080 (idempotent)
        curl -fsS -o /dev/null -X POST localhost:8474/proxies \
          -d '{"name":"shelfie","listen":"0.0.0.0:8666","upstream":"shelfie-ref:8080"}' 2>/dev/null || true
        # Bucket for pre-signed cover uploads (Module 4.6); "already exists" is fine
        compose exec -T storage sh -c 'echo "s3.bucket.create -name covers" | weed shell' >/dev/null 2>&1 || true
        echo "Shelfie reference server is up:"
        echo "  GraphiQL   http://localhost:8080/graphiql"
        echo "  GraphQL    http://localhost:8080/graphql      (inside the image: http://shelfie-ref:8080/graphql)"
        echo "  REST       http://localhost:8080/api/clubs/c1"
        echo "  gRPC       localhost:9090                     (grpcurl -plaintext shelfie-ref:9090 list)"
        echo "  slow path  http://localhost:8666              (bin/course toxi latency 700)"
        echo "  Keycloak   http://localhost:8180              (realm shelfie; inside the image: http://keycloak:8180)"
        echo "  Kafka      localhost:9092                     (inside the image: kafka:9092)"
        echo "  storage    http://localhost:8333              (S3 API, inside the image: http://storage:8333)"
        echo "  Voyager    http://localhost:8080/voyager.html (needs internet in your browser)" ;;
      reset) curl -fsS -X POST localhost:8080/_course/reset-data && echo "Reference data back to the seed." ;;
      down) compose down ;;
      logs) compose logs -f shelfie-ref ;;
      status) compose ps ;;
      *) die "usage: bin/course ref up [--rebuild]|down|status|logs|reset" ;;
    esac ;;
  toxi)
    case "${1:-}" in
      latency)
        ms="${2:?usage: bin/course toxi latency <ms>}"
        curl -fsS -o /dev/null -X DELETE localhost:8474/proxies/shelfie/toxics/latency 2>/dev/null || true
        curl -fsS -o /dev/null -X POST localhost:8474/proxies/shelfie/toxics \
          -d "{\"name\":\"latency\",\"type\":\"latency\",\"stream\":\"downstream\",\"attributes\":{\"latency\":$ms}}" \
          || die "toxiproxy not reachable; run bin/course ref up"
        echo "Added ${ms} ms per response on http://localhost:8666 (image: http://toxiproxy:8666)" ;;
      reset)
        curl -fsS -o /dev/null -X DELETE localhost:8474/proxies/shelfie/toxics/latency 2>/dev/null || true
        echo "Latency removed." ;;
      *) die "usage: bin/course toxi latency <ms> | reset" ;;
    esac ;;
  doctor)
    "$ROOT/tools/doctor-host.sh" "$ROOT" "$IMAGE" || true
    in_image /course/tools/course.sh doctor ;;
  shell) in_image bash "$@" ;;   # bin/course shell -c "cmd" runs one command
  native)   # GraalVM native-image builds (game 6b), in their own image; runs mvn in the current directory
    [[ $# -ge 1 ]] || die "usage: bin/course native <mvn args>   (from a project directory inside the repo)"
    docker image inspect graphql-course-native:1 >/dev/null 2>&1 \
      || docker build -t graphql-course-native:1 -f "$ROOT/docker/native.Dockerfile" "$ROOT/docker" >&2
    case "$PWD/" in "$ROOT"/*) ;; *) die "run bin/course native from a directory inside the course repo" ;; esac
    docker run --rm -u "$COURSE_UID:$COURSE_GID" -e HOME=/tmp -v "$ROOT":/course -w "/course${PWD#"$ROOT"}" \
      graphql-course-native:1 mvn "$@" ;;
  inspector)   # graphql-inspector (lab 7.6, Module 7 games), in its own Node.js image; paths relative to the current directory
    [[ $# -ge 1 ]] || die "usage: bin/course inspector <args>   e.g. bin/course inspector diff old.graphql new.graphql"
    docker image inspect graphql-course-inspector:1 >/dev/null 2>&1 \
      || docker build -t graphql-course-inspector:1 -f "$ROOT/docker/inspector.Dockerfile" "$ROOT/docker" >&2
    case "$PWD/" in "$ROOT"/*) ;; *) die "run bin/course inspector from a directory inside the course repo" ;; esac
    docker run --rm -u "$COURSE_UID:$COURSE_GID" -e HOME=/tmp -v "$ROOT":/course -w "/course${PWD#"$ROOT"}" \
      graphql-course-inspector:1 "$@" ;;
  fed)    # Module 15's routers are already fetched above (ensure_fed); show what is there
    ls -1 "$ROOT/.cache/fed/bin" ;;
  rover)  # Apollo's Rover CLI inside the course image (Module 15, optional). Its composition plugin is under the
          # Elastic License 2.0: this command accepts it (APOLLO_ELV2_LICENSE=accept), as the course owner decided
          # on 2026-11-24. Plugins in .cache/fed/rover; Apollo's anonymous telemetry off.
    [[ $# -ge 1 ]] || die "usage: bin/course rover supergraph compose --config supergraph.yaml [--output out.graphql]"
    echo "course: rover's composition is under the Elastic License 2.0 (https://www.elastic.co/licensing/elastic-license); running it accepts that licence" >&2
    in_image env APOLLO_ELV2_LICENSE=accept APOLLO_TELEMETRY_DISABLED=true APOLLO_HOME=/course/.cache/fed/rover \
      /course/.cache/fed/bin/rover "$@" ;;
  ops)    # Module 16's observability stack is already fetched above (ensure_ops); show what is there
    ls -1 "$ROOT/.cache/ops/bin" "$ROOT/.cache/ops/grafana/bin" ;;
  node)   # Node.js and npm from .cache/node inside the course image (graphql-eslint, SpectaQL); npm's cache in .cache/npm
    [[ $# -ge 1 ]] || die "usage: bin/course node npm ci | node <script> | npx <tool> ..."
    in_image bash -c 'PATH="/course/.cache/node/bin:$PATH" npm_config_cache=/course/.cache/npm npm_config_update_notifier=false exec "$@"' node "$@" ;;
  web)   # lab 12.6: npm (Apollo Client, Relay, jsdom) in the official Node.js image, on the course network so
         # http://shelfie-ref:8080 resolves; npm's cache in .cache/npm. Run it from a web/ project directory.
    [[ $# -ge 1 ]] || die "usage: bin/course web <npm args>   e.g. bin/course web ci && bin/course web run measure"
    case "$PWD/" in "$ROOT"/*) ;; *) die "run bin/course web from a directory inside the course repo" ;; esac
    mkdir -p "$ROOT/.cache/npm"
    net=(); docker network inspect "$NETWORK" >/dev/null 2>&1 && net=(--network "$NETWORK")
    docker run --rm "${net[@]}" -u "$COURSE_UID:$COURSE_GID" -e HOME=/tmp -e npm_config_cache=/course/.cache/npm \
      -e npm_config_update_notifier=false -v "$ROOT":/course -w "/course${PWD#"$ROOT"}" node:24.22.1-slim npm "$@" ;;
  go)     # lab 18.6's Go path: the official Go image (the course image has no Go), on the course network; modules
          # and the build cache in .cache/go. Builds are static Linux binaries (CGO_ENABLED=0), which then run in
          # the course image. Run it from the Go project's directory.
    [[ $# -ge 1 ]] || die "usage: bin/course go <go args>   e.g. bin/course go run github.com/99designs/gqlgen generate, bin/course go build -o reviews ."
    case "$PWD/" in "$ROOT"/*) ;; *) die "run bin/course go from a directory inside the course repo" ;; esac
    mkdir -p "$ROOT/.cache/go"
    net=(); docker network inspect "$NETWORK" >/dev/null 2>&1 && net=(--network "$NETWORK")
    docker run --rm "${net[@]}" -u "$COURSE_UID:$COURSE_GID" -e HOME=/tmp -e GOPATH=/course/.cache/go \
      -e GOMODCACHE=/course/.cache/go/mod -e GOCACHE=/course/.cache/go/build -e CGO_ENABLED=0 -e GOOS=linux \
      -e GOTOOLCHAIN=local -v "$ROOT":/course -w "/course${PWD#"$ROOT"}" golang:1.27.2-bookworm go "$@" ;;
  mobile)   # lab 12.7: Apollo Kotlin needs Gradle (its code generator is a Gradle plugin only). The official Gradle
            # image, on the course network; Gradle's caches in .cache/gradle. Run it from the lab's mobile/ directory.
    [[ $# -ge 1 ]] || die "usage: bin/course mobile <cmd>   e.g. bin/course mobile gradle -q installDist, bin/course mobile ./airplane.sh"
    case "$PWD/" in "$ROOT"/*) ;; *) die "run bin/course mobile from a directory inside the course repo" ;; esac
    mkdir -p "$ROOT/.cache/gradle"
    net=(); docker network inspect "$NETWORK" >/dev/null 2>&1 && net=(--network "$NETWORK")
    docker run --rm "${net[@]}" -u "$COURSE_UID:$COURSE_GID" -e HOME=/tmp -e GRADLE_USER_HOME=/course/.cache/gradle \
      -e GRADLE_OPTS=-Dorg.gradle.daemon=false -v "$ROOT":/course -w "/course${PWD#"$ROOT"}" gradle:9.9.1-jdk21 "$@" ;;
  seckit)   # graphql-cop and Clairvoyance (lab 10.8), in their own Python image
    [[ $# -ge 1 ]] || die "usage: bin/course seckit graphql-cop -t http://localhost:4000/graphql | clairvoyance <url> -o schema.json"
    docker image inspect graphql-course-seckit:1 >/dev/null 2>&1 \
      || docker build -t graphql-course-seckit:1 -f "$ROOT/docker/seckit.Dockerfile" "$ROOT/docker" >&2
    # Join the network namespace of the newest running course container, where your app listens.
    cid=$(docker ps --filter ancestor="$IMAGE" --format '{{.ID}} {{.Label "com.docker.compose.project"}}' | awk '$2 == "" {print $1; exit}')
    net=(--network "$NETWORK"); [[ -n "$cid" ]] && net=(--network "container:$cid")
    case "$PWD/" in "$ROOT"/*) wd="/course${PWD#"$ROOT"}" ;; *) wd=/course ;; esac
    docker run --rm "${net[@]}" -u "$COURSE_UID:$COURSE_GID" -v "$ROOT":/course -w "$wd" graphql-course-seckit:1 "$@" ;;
  checkpoint)   # a module may also check something only the host can do (Module 15: docker compose up)
    host_check=$(compgen -G "$ROOT/modules/m${1:-xx}-*/checkpoint-host.sh" | head -1 || true)
    if [[ -n "$host_check" ]]; then ROOT="$ROOT" bash "$host_check" || die "checkpoint-${1} not reached yet"; fi
    in_image /course/tools/course.sh checkpoint "$@" ;;
  *) in_image /course/tools/course.sh "$cmd" "$@" ;;
esac
